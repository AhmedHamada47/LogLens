@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="empty-state">
    <div class="empty-state-icon">&#9888;</div>
    <div class="empty-state-title">Something went wrong</div>
    <div class="empty-state-hint">An error occurred while processing your request.</div>
    @if (Model.ShowRequestId)
    {
        <p style="margin-top: 1rem; font-size: 0.75rem; color: var(--text-muted);">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-accent mt-3">Back to Dashboard</a>
</div>
